-- JSON (pure Luau, for TableMissionSetup). null becomes nil (absent).
-------------------------------------------------------------------------------
-- >>> shared JSON (spliced by tools/build.py) <<<
-------------------------------------------------------------------------------
local function jsonDecode(text)
	local pos, n = 1, #text

	local function skip()
		pos = find(text, "[^ \t\r\n]", pos) or (n + 1)
	end
	local function jfail(msg)
		fail("JSON: " .. msg .. " at " .. pos)
	end

	local parseValue

	local function utf8Encode(cp)
		if cp < 0x80 then
			return char(cp)
		elseif cp < 0x800 then
			return char(0xC0 + cp // 64, 0x80 + cp % 64)
		elseif cp < 0x10000 then
			return char(0xE0 + cp // 4096, 0x80 + (cp // 64) % 64, 0x80 + cp % 64)
		end
		return char(0xF0 + cp // 262144, 0x80 + (cp // 4096) % 64, 0x80 + (cp // 64) % 64, 0x80 + cp % 64)
	end

	local SIMPLE = { ['"'] = '"', ["\\"] = "\\", ["/"] = "/", b = "\b", f = "\f", n = "\n", r = "\r", t = "\t" }

	local function parseString()
		pos = pos + 1 -- opening quote
		local parts = {}
		while true do
			local s, e = find(text, '["\\]', pos)
			if not s then
				jfail("unterminated string")
			end
			if s > pos then
				parts[#parts + 1] = sub(text, pos, s - 1)
			end
			if sub(text, s, s) == '"' then
				pos = e + 1
				return concat(parts)
			end
			local esc = sub(text, s + 1, s + 1)
			if esc == "u" then
				local hex = match(text, "^%x%x%x%x", s + 2)
				if not hex then
					jfail("bad \\u escape")
				end
				local cp = tonumber(hex, 16)
				pos = s + 6
				if cp >= 0xD800 and cp <= 0xDBFF then
					local lo = match(text, "^\\u(%x%x%x%x)", pos)
					if lo then
						local l = tonumber(lo, 16)
						if l >= 0xDC00 and l <= 0xDFFF then
							cp = 0x10000 + (cp - 0xD800) * 1024 + (l - 0xDC00)
							pos = pos + 6
						end
					end
				end
				parts[#parts + 1] = utf8Encode(cp)
			else
				local rep = SIMPLE[esc]
				if rep == nil then
					jfail("bad escape \\" .. esc)
				end
				parts[#parts + 1] = rep
				pos = s + 2
			end
		end
	end

	local function parseNumber()
		local s, e = find(text, "^-?%d+%.?%d*[eE]?[+-]?%d*", pos)
		if not s then
			jfail("bad number")
		end
		local v = tonumber(sub(text, s, e))
		if v == nil then
			jfail("bad number")
		end
		pos = e + 1
		return v
	end

	local function parseObject(depth)
		pos = pos + 1
		local obj = {}
		skip()
		if sub(text, pos, pos) == "}" then
			pos = pos + 1
			return obj
		end
		while true do
			skip()
			if sub(text, pos, pos) ~= '"' then
				jfail("expected object key")
			end
			local key = parseString()
			skip()
			if sub(text, pos, pos) ~= ":" then
				jfail("expected ':'")
			end
			pos = pos + 1
			obj[key] = parseValue(depth + 1)
			skip()
			local c = sub(text, pos, pos)
			pos = pos + 1
			if c == "}" then
				return obj
			elseif c ~= "," then
				jfail("expected ',' or '}'")
			end
		end
	end

	local function parseArray(depth)
		pos = pos + 1
		local arr, k = {}, 0
		skip()
		if sub(text, pos, pos) == "]" then
			pos = pos + 1
			return arr
		end
		while true do
			k = k + 1
			arr[k] = parseValue(depth + 1) -- a null leaves a hole, as in most embedders
			skip()
			local c = sub(text, pos, pos)
			pos = pos + 1
			if c == "]" then
				return arr
			elseif c ~= "," then
				jfail("expected ',' or ']'")
			end
		end
	end

	function parseValue(depth)
		if depth > 200 then
			jfail("nesting too deep")
		end
		skip()
		local c = sub(text, pos, pos)
		if c == "{" then
			return parseObject(depth)
		elseif c == "[" then
			return parseArray(depth)
		elseif c == '"' then
			return parseString()
		elseif c == "t" and sub(text, pos, pos + 3) == "true" then
			pos = pos + 4
			return true
		elseif c == "f" and sub(text, pos, pos + 4) == "false" then
			pos = pos + 5
			return false
		elseif c == "n" and sub(text, pos, pos + 3) == "null" then
			pos = pos + 4
			return nil
		elseif c == "-" or find(c, "^%d") then
			return parseNumber()
		end
		jfail("unexpected character '" .. c .. "'")
		return nil
	end

	local v = parseValue(0)
	skip()
	if pos <= n then
		jfail("trailing data")
	end
	return v
end


-- Deterministic JSON encoder: object keys sorted, numbers round-trip exactly (%.17g), arrays = 1..n sequences.
local function jsonEncode(value)
	local parts, n = {}, 0
	local function put(x)
		n = n + 1
		parts[n] = x
	end
	local ESCAPES = { ['"'] = '\\"', ["\\"] = "\\\\", ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t", ["\b"] = "\\b", ["\f"] = "\\f" }
	local function encString(str)
		put('"')
		put((string.gsub(str, '[%c"\\]', function(c)
			return ESCAPES[c] or string.format("\\u%04x", string.byte(c))
		end)))
		put('"')
	end
	local function enc(v, depth)
		if depth > 200 then
			fail("JSON encode: nesting too deep")
		end
		local t = type(v)
		if t == "string" then
			encString(v)
		elseif t == "number" then
			if v ~= v or v == math.huge or v == -math.huge then
				fail("JSON encode: cannot encode NaN or infinity")
			end
			if v == math.floor(v) and math.abs(v) < 2 ^ 53 then
				put(string.format("%d", v))
			else
				put(string.format("%.17g", v))
			end
		elseif t == "boolean" then
			put(v and "true" or "false")
		elseif t == "table" then
			local len = #v
			local isArray = len > 0 or next(v) == nil
			if isArray then
				for k in pairs(v) do
					if type(k) ~= "number" or k < 1 or k > len or k ~= math.floor(k) then
						isArray = false
						break
					end
				end
			end
			if isArray then
				put("[")
				for i = 1, len do
					if i > 1 then
						put(",")
					end
					enc(v[i], depth + 1)
				end
				put("]")
			else
				local keys = {}
				for k in pairs(v) do
					if type(k) ~= "string" then
						fail("JSON encode: object keys must be strings")
					end
					keys[#keys + 1] = k
				end
				table.sort(keys)
				put("{")
				for i, k in ipairs(keys) do
					if i > 1 then
						put(",")
					end
					encString(k)
					put(":")
					enc(v[k], depth + 1)
				end
				put("}")
			end
		else
			fail("JSON encode: unsupported value type " .. t)
		end
	end
	enc(value, 0)
	return concat(parts)
end

-- <<< END shared JSON <<<

function Codec.jsonEncode(value)
	local ok, res = pcall(jsonEncode, value)
	if ok then
		return res
	end
	return nil, res
end

function Codec.jsonDecode(text)
	local ok, res = pcall(jsonDecode, text)
	if ok then
		return res
	end
	return nil, res
end

-------------------------------------------------------------------------------
-- Base64 (standard alphabet; also accepts URL-safe; ignores whitespace and padding)
-------------------------------------------------------------------------------
local B64 = {}
do
	local a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do
		B64[byte(a, i)] = i - 1
	end
	B64[byte("-")] = 62
	B64[byte("_")] = 63
end

local function base64Decode(text)
	local out, k, chunk = {}, 0, {}
	local acc, bits, nchunk = 0, 0, 0
	for i = 1, #text do
		local c = byte(text, i)
		local v = B64[c]
		if v ~= nil then
			acc = acc * 64 + v
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				local div = 2 ^ bits
				local b = math.floor(acc / div)
				acc = acc - b * div
				nchunk = nchunk + 1
				chunk[nchunk] = b
				if nchunk == 2048 then
					k = k + 1
					out[k] = char(table.unpack(chunk, 1, nchunk))
					nchunk = 0
				end
			end
		elseif c ~= 61 and c ~= 32 and c ~= 10 and c ~= 13 and c ~= 9 then
			fail("invalid Base64 character at " .. i)
		end
	end
	if nchunk > 0 then
		k = k + 1
		out[k] = char(table.unpack(chunk, 1, nchunk))
	end
	return concat(out)
end

function Codec.base64Decode(text)
	local ok, res = pcall(base64Decode, text)
	if ok then
		return res
	end
	return nil, res
end

-------------------------------------------------------------------------------
-- Pieces, headers, gist wrapper
-------------------------------------------------------------------------------
local function trim(s)
	return (gsub(gsub(s, "^%s+", ""), "%s+$", ""))
end

local function parsePiece(text)
	if type(text) ~= "string" then
		fail("piece must be a string")
	end
	text = trim(text)
	if sub(text, 1, 3) == "!!!" then
		local rest = match(text, "^!!!.-!!!(.+)$")
		if rest == nil then
			fail("malformed opening comment (no closing !!!)")
		end
		text = rest
	end
	if #text < 7 then
		fail("piece shorter than the 7-symbol header")
	end
	local r = { s = text, p = 1, n = #text }
	local version = num(r, 1)
	local mapId = num(r, 2)
	local current = num(r, 2)
	local total = num(r, 2)
	if version > 2 then
		fail("unsupported code version " .. version .. " (this decoder knows 0, 1, 2)")
	end
	if total < 1 or current < 1 or current > total then
		fail("bad piece numbering " .. current .. "/" .. total)
	end
	return { Version = version, MapId = mapId, Current = current, Total = total, Payload = sub(text, 8) }
end

function Codec.parsePiece(text)
	local ok, res = pcall(parsePiece, text)
	if ok then
		return res
	end
	return nil, res
end

local function assemble(pieces)
	if type(pieces) == "string" then
		pieces = { pieces }
	end
	if #pieces == 0 then
		fail("no pieces given")
	end
	local first
	local slots = {}
	for _, text in ipairs(pieces) do
		local p = parsePiece(text)
		if first == nil then
			first = p
		elseif p.Version ~= first.Version then
			fail("code version mismatch between pieces")
		elseif p.MapId ~= first.MapId then
			fail("map id mismatch between pieces (pieces belong to different missions)")
		elseif p.Total ~= first.Total then
			fail("piece count mismatch between pieces")
		end
		if slots[p.Current] ~= nil and slots[p.Current] ~= p.Payload then
			fail("piece " .. p.Current .. " was given twice with different contents")
		end
		slots[p.Current] = p.Payload
	end
	local parts = {}
	for i = 1, first.Total do
		if slots[i] == nil then
			fail("missing piece " .. i .. " of " .. first.Total)
		end
		parts[i] = slots[i]
	end
	return { Version = first.Version, MapId = first.MapId, Total = first.Total, Payload = concat(parts) }
end

function Codec.assemble(pieces)
	local ok, res = pcall(assemble, pieces)
	if ok then
		return res
	end
	return nil, res
end

function Codec.normalizeGistUrl(url)
	url = trim(url)
	if not find(url, "^https?://") then
		return nil, "BreachCodec: not an http(s) URL"
	end
	local user, id = match(url, "^https?://gist%.github%.com/([^/]+)/([^/?#]+)")
	if user then
		return "https://gist.githubusercontent.com/" .. user .. "/" .. id .. "/raw"
	end
	if find(url, "^https?://gist%.githubusercontent%.com/[^/]+/[^/]+/raw") then
		return url
	end
	return nil, "BreachCodec: not a recognised gist URL"
end

-------------------------------------------------------------------------------
-- Mission assembly
-------------------------------------------------------------------------------
function Codec.resolveRef(root, path)
	local cur = root
	for idx in string.gmatch(path, "%d+") do
		cur = cur and cur.Children[tonumber(idx)]
		if cur == nil then
			return nil
		end
	end
	return cur
end

local function childNamed(node, name)
	for _, c in ipairs(node.Children) do
		if c.Name == name then
			return c
		end
	end
	return nil
end

local function buildMission(root, host, warnings)
	local mission = { Root = root, Warnings = warnings, SetupModules = {} }
	local jd = (host and host.jsonDecode) or jsonDecode

	local tableSetup = childNamed(root, "TableMissionSetup")
	if tableSetup and tableSetup.Props.Value ~= "" then
		local ok, res = pcall(jd, tableSetup.Props.Value)
		if ok and type(res) == "table" then
			if type(res.Colors) == "table" then
				for k, v in pairs(res.Colors) do
					if type(v) == "table" then
						res.Colors[k] = { R = v[1], G = v[2], B = v[3] }
					end
				end
			end
			mission.Setup = res
		else
			warnings[#warnings + 1] = "TableMissionSetup could not be decoded: " .. tostring(res)
		end
	else
		warnings[#warnings + 1] = "mission has no TableMissionSetup"
	end

	local strSetup = childNamed(root, "StringMissionSetup")
	if strSetup then
		mission.SetupSource = strSetup.Props.Value
		for _, c in ipairs(strSetup.Children) do
			mission.SetupModules[c.Name] = c.Props.Value
		end
	end

	local cms = childNamed(root, "CustomMissionSettings")
	if cms then
		mission.Settings = {}
		for _, c in ipairs(cms.Children) do
			mission.Settings[c.Name] = c.Props.Value
		end
	end
	return mission
end

local function decodeStream(raw, version, host)
	local r = newReader(raw, version, host and host.maxDepth)
	local warnings = {}
	local colors = readColorMap(r)
	local strings = readStringMap(r)
	local root = readInstance(r, colors, strings, 1, warnings)
	if root == nil then
		fail("stream's root instance is Nil (unsupported class)")
	end
	if r.p <= r.n then
		warnings[#warnings + 1] = "trailing data after the instance tree (" .. (r.n - r.p + 1) .. " symbols)"
	end
	return buildMission(root, host, warnings)
end

function Codec.decodeStream(raw, version, host)
	local ok, res = pcall(decodeStream, raw, version, host)
	if ok then
		return res
	end
	return nil, res
end

local function decode(input, host)
	host = host or {}
	if type(input) == "string" and find(trim(input), "^https?://") then
		fail("input is a URL; fetch it in the host and pass the text (see Codec.normalizeGistUrl)")
	end
	local asm = assemble(input)
	local raw = asm.Payload
	if asm.Version >= 2 then
		local b64 = host.base64Decode or base64Decode
		local bytes = b64(raw)
		local z = host.zstdDecompress
		if z == nil then
			fail("version-2 codes are Zstd-compressed: provide host.zstdDecompress(bytes) -> string")
		end
		local zerr
		raw, zerr = z(bytes)
		if type(raw) ~= "string" then
			fail(zerr and tostring(zerr) or "host.zstdDecompress must return a string")
		end
		if #raw > (host.maxRawSize or DEFAULT_MAX_RAW) then
			fail("decompressed stream larger than the allowed maximum")
		end
	end
	local mission = decodeStream(raw, asm.Version, host)
	mission.Version = asm.Version
	mission.MapId = asm.MapId
	return mission
end

function Codec.decode(input, host)
	local ok, res = pcall(decode, input, host)
	if ok then
		return res
	end
	return nil, res
end

return Codec
