--!nocheck
--[[
	Decode real mission codes from disk and print a report.

	    luau tests/localfile.luau                      -- decodes every file listed in FILES below
	    luau tests/localfile.luau -a path/to/code.txt  -- (CLI builds that pass script args) or edit FILES

	File reading depends on your Luau host (the plain `luau` CLI has no `io`):
	  1. `io.open` if your host provides it,
	  2. Lune's `@lune/fs` if you run under Lune,
	  3. otherwise a module generated by tools/embed.sh:   sh tools/embed.sh a.base64 b.base64 > tests/_embedded.luau
	     (tests/_embedded.luau ships pre-generated for tests/data/TheDiplomat.base64)
	  Easiest: `sh tools/addmap.sh <url-or-file>` downloads/copies a map, re-embeds everything and runs this report.
]]

local Codec = require("../BreachCodec")
local Zstd = require("../BreachZstd")
local Known = require("./known_components")
local Validator = require("../BreachValidator")
local Mission = require("../BreachMission")
local World = require("../BreachWorld")

local FILES = { "TheDiplomat.base64", "TheInterception.base64" } -- looked up in tests/data/ then the working dir

-------------------------------------------------------------------------------- file access
local function readFile(name)
	local candidates = { "tests/data/" .. name, name, "data/" .. name, "../" .. name }
	if io and io.open then
		for _, path in ipairs(candidates) do
			local f = io.open(path, "rb")
			if f then
				local s = f:read("*a")
				f:close()
				return s, path
			end
		end
	end
	local okFs, fs = pcall(require, "@lune/fs")
	if okFs and fs then
		for _, path in ipairs(candidates) do
			if fs.isFile(path) then
				return fs.readFile(path), path
			end
		end
	end
	local okEmb, emb = pcall(require, "./_embedded")
	if okEmb and type(emb) == "table" and emb[name] then
		return emb[name], "tests/_embedded.luau"
	end
	return nil
end

-------------------------------------------------------------------------------- report helpers
local function sortedKeys(t, by)
	local ks = {}
	for k in pairs(t) do ks[#ks + 1] = k end
	table.sort(ks, by or function(a, b) return tostring(a) < tostring(b) end)
	return ks
end

local function topN(counts, n)
	local ks = sortedKeys(counts, function(a, b)
		if counts[a] ~= counts[b] then return counts[a] > counts[b] end
		return tostring(a) < tostring(b)
	end)
	local out = {}
	for i = 1, math.min(n, #ks) do out[i] = ("%s×%d"):format(tostring(ks[i]), counts[ks[i]]) end
	return table.concat(out, ", ")
end

local function report(name, text)
	print(("\n==================== %s"):format(name))
	local piece, perr = Codec.parsePiece(text)
	if piece then
		print(("header: version %d, map id %d, piece %d/%d, payload %d chars"):format(piece.Version, piece.MapId, piece.Current, piece.Total, #piece.Payload))
	else
		print("header: " .. tostring(perr))
	end

	local t0 = os.clock()
	local host = { zstdDecompress = Zstd.decompress }
	local m, err = Codec.decode(text, host)
	if not m then
		-- fallback 1: one piece per line
		local lines = {}
		for line in string.gmatch(text, "[^\r\n]+") do lines[#lines + 1] = line end
		if #lines > 1 then
			m, err = Codec.decode(lines, host)
			if m then print("(decoded as " .. #lines .. " pieces, one per line)") end
		end
	end
	if not m then
		-- fallback 2: a bare Base64 payload with no header (assume version 2, single piece)
		m, err = Codec.decode("dbbbcbc" .. text:gsub("%s", ""), host)
		if m then print("(decoded as a bare Base64 payload with no header)") end
	end
	if not m then
		print("DECODE FAILED: " .. tostring(err))
		return
	end
	local dt = os.clock() - t0
	print(("decoded in %.2fs   version %d   map id %s   warnings %d"):format(dt, m.Version, tostring(m.MapId), #m.Warnings))
	for _, w in ipairs(m.Warnings) do print("  warning: " .. w) end

	-- walk the tree
	local nodes, classes, types, attrNames, unknownTypes, unknownAttrs, optOuts = 0, {}, {}, {}, {}, {}, {}
	local known = Known.components
	local globals = {}
	for _, g in ipairs(Known.globals) do globals[g] = true end
	local function walk(n, depth)
		nodes += 1
		classes[n.ClassName] = (classes[n.ClassName] or 0) + 1
		for k in pairs(n.Attrs) do attrNames[k] = (attrNames[k] or 0) + 1 end
		local key
		if n.ClassName == "BoolValue" then key = n.Attrs.Type else key = n.Name end
		if n.ClassName == "BoolValue" and key then types[key] = (types[key] or 0) + 1 end
		local optedOut = n.Attrs.IKnowWhatImDoingDoNotValidate == true or n.Attrs.NoValidation
		if optedOut then optOuts[key or "?"] = (optOuts[key or "?"] or 0) + 1 end
		if key and not optedOut and n.ClassName ~= "Folder" and n.Attrs.Type ~= "StateScript" and next(n.Attrs) ~= nil and not n.Attrs.AltProp and not n.Attrs.AltPropModel then
			local entry = known[key]
			if entry == nil then
				unknownTypes[key] = (unknownTypes[key] or 0) + 1
			else
				local allowed = {}
				for _, a in ipairs(entry) do allowed[a] = true end
				for k in pairs(n.Attrs) do
					if not allowed[k] and not globals[k] then
						unknownAttrs[key .. "." .. k] = (unknownAttrs[key .. "." .. k] or 0) + 1
					end
				end
			end
		end
		for _, c in ipairs(n.Children) do walk(c, depth + 1) end
	end
	walk(m.Root, 0)

	print(("tree: %d instances under %s (%s)"):format(nodes, m.Root.Name, m.Root.ClassName))
	print("top-level children:")
	for _, c in ipairs(m.Root.Children) do
		print(("  %-22s %-12s children=%d attrs=%d"):format(c.Name, c.ClassName, #c.Children, (function() local n = 0 for _ in pairs(c.Attrs) do n += 1 end return n end)()))
	end
	print("classes: " .. topN(classes, 30))
	print("BoolValue Types: " .. topN(types, 40))
	print("most-used attribute names: " .. topN(attrNames, 25))
	if next(unknownTypes) then print("components NOT in the plugin's attribute map: " .. topN(unknownTypes, 40)) end
	if next(unknownAttrs) then print("attributes NOT in the map for their component: " .. topN(unknownAttrs, 40)) end
	if next(optOuts) then print("components that opt out of validation (IKnowWhatImDoingDoNotValidate / NoValidation): " .. topN(optOuts, 20)) end

	-- validator pass: exporter mode must reproduce what the real exporter wrote (0 changes, 0 non-opt-out issues)
	local vr = Validator.validateMission(m, { mode = "exporter", includeDefaults = false, inPlace = false })
	local byKind = {}
	for _, i in ipairs(vr.issues) do byKind[i.kind] = (byKind[i.kind] or 0) + 1 end
	print(("validator (exporter mode): %d nodes, %d validated, %d changed, issues: %s"):format(vr.nodes, vr.validated, vr.changed, topN(byKind, 10) ~= "" and topN(byKind, 10) or "none"))
	local shown = 0
	for _, i in ipairs(vr.issues) do
		if i.kind ~= "opt-out" and shown < 10 then
			shown += 1
			print(("  %s: %s.%s -- %s"):format(i.kind, i.path, tostring(i.attribute), i.message))
		end
	end
	local er = Validator.validateMission(m, { mode = "engine", includeDefaults = true, inPlace = false })
	print(("validator (engine mode): %d issues, %d nodes had defaults filled"):format(#er.issues, er.changed))

	-- world layer (cells, links, navigation)
	local built = Mission.build(m, { validator = Validator })
	local world = World.build(built)
	local dg = world.Diagnostics
	print(("world: %d cells, %d links (%d bridge >=2 cells, %d touch none), %d cell components"):format(dg.cells, dg.links, dg.linksBridgingCells, dg.linksTouchingNoCell, dg.cellComponents))
	print(("navigation: %d nodes, %d edges + %d link edges (%d one-way), %d components, %d cells with suspect (copied) Path data"):format(dg.navNodes, dg.navEdgesIntra, dg.navEdgesInter, dg.navOneWayEdges, dg.navComponents, dg.navSuspectCells))
	local zones = {}
	for _, c in ipairs(world.Cells) do zones[c.Zone] = (zones[c.Zone] or 0) + 1 end
	print("cell zone classes: " .. topN(zones, 20))
	for _, wmsg in ipairs(world.Warnings) do print("  world warning: " .. wmsg) end

	if m.Settings then
		print("CustomMissionSettings:")
		for _, k in ipairs(sortedKeys(m.Settings)) do print(("  %s = %s"):format(k, tostring(m.Settings[k]))) end
	end
	if m.Setup then
		print("MissionSetup keys: " .. table.concat(sortedKeys(m.Setup), ", "))
		local colors = 0
		if m.Setup.Colors then for _ in pairs(m.Setup.Colors) do colors += 1 end end
		local objKeys = {}
		if type(m.Setup.Objectives) == "table" then
			for k in pairs(m.Setup.Objectives) do objKeys[#objKeys + 1] = tostring(k) end
			table.sort(objKeys)
		end
		print(("  Colors: %d   Objective groups: [%s]   CustomStrings: %s"):format(colors, table.concat(objKeys, ", "), (function()
			local n = 0
			if m.Setup.CustomStrings then for _ in pairs(m.Setup.CustomStrings) do n += 1 end end
			return n
		end)()))
	end
	if m.SetupSource then print(("MissionSetup source: %d chars; modules: %s"):format(#m.SetupSource, table.concat(sortedKeys(m.SetupModules), ", "))) end
end

-------------------------------------------------------------------------------- main
-- every other map found in tests/_embedded.luau is reported too (tools/addmap.sh puts new ones there)
do
	local okEmb, emb = pcall(require, "./_embedded")
	if okEmb and type(emb) == "table" then
		local listed = {}
		for _, n in ipairs(FILES) do listed[n] = true end
		local extra = {}
		for n in pairs(emb) do if not listed[n] then extra[#extra + 1] = n end end
		table.sort(extra)
		for _, n in ipairs(extra) do FILES[#FILES + 1] = n end
	end
end

local found = 0
for _, name in ipairs(FILES) do
	local text, where = readFile(name)
	if text then
		found += 1
		print(("read %s (%d bytes) from %s"):format(name, #text, where))
		report(name, text)
	else
		print(("\n(skipping %s: not found. See the header of this file for how to supply it.)"):format(name))
	end
end
if found == 0 then error("no input files could be read") end
